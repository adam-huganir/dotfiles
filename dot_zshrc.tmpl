# Zsh stuff
zmodload zsh/datetime
autoload -z edit-command-line
zle -N edit-command-line
#bindkey -M vicmd v edit-command-line

setopt extended_glob
setopt GLOB_STAR_SHORT
unsetopt autocd
set +x

# Shared env + helpers (command_found, exists, add_to_path, PATH, exports) are
# loaded by ~/.zshenv -> ~/.shenv before this file. This file is interactive-only.

export OMZ_HOME=$HOME/.oh-my-zsh

# USER stuff and custom local overrides
exists "$HOME/.alias" && . "$HOME/.alias"
exists "$HOME/.zshrc.d/zshrc.zsh" && . "$HOME/.zshrc.d/zshrc.zsh"

###### BEGIN  OH-MY-ZSH ######
ZSH_THEME="agnoster" # starship overrides
COMPLETION_WAITING_DOTS="true"

# History
HIST_STAMPS="yyyy-mm-dd"
HISTSIZE=50000
SAVEHIST=100000

# OH-MY-ZSH
plugins=(
  battery
  bgnotify
  command-not-found
  copybuffer
  docker
  fast-syntax-highlighting
  fzf
  gh
  git
  gitignore
  httpie
  isodate
  kubectx
  microk8s
  nmap
  pip
  poetry
  rust
  ssh-agent
  terraform
  ubuntu
  ufw
  wakeonlan
  zsh-completions
  zsh-autosuggestions
)
CUSTOM_OMZ_FILE="$HOME/.zshrc.d/omz-additional.zsh" # e.g. for adding plugins
if exists "$CUSTOM_OMZ_FILE"; then
  . $CUSTOM_OMZ_FILE
fi
source "$OMZ_HOME/oh-my-zsh.sh" 

# plugin  settings
notify_threshold=120 # for bgnotify min seconds
FAST_HIGHLIGHT[use_brackets]=1 # brackets work correctly

###### END OH-MY-ZSH ######

### Vim mode
MODE_CURSOR_VIINS="#00ff00 blinking bar"
MODE_CURSOR_REPLACE="$MODE_CURSOR_VIINS #ff0000"
MODE_CURSOR_VICMD="green block"
MODE_CURSOR_SEARCH="#ff00ff steady underline"
MODE_CURSOR_VISUAL="$MODE_CURSOR_VICMD steady bar"
MODE_CURSOR_VLINE="$MODE_CURSOR_VISUAL #00ffff"

### fzf
exists "$HOME/.fzf.zsh" && . "$HOME/.fzf.zsh"

### pyenv
# command_found pyenv && eval "$(pyenv init -)"

# Program aliases and custom setup
command_found thefuck && eval $(thefuck --alias) && eval $(thefuck --alias oops)
command_found github-copilot-cli && eval "$(github-copilot-cli alias -- "$0")"

################################

### Misc completions ###
command_found pipx && eval "$(register-python-argcomplete pipx)"
command_found ruff && eval "$(ruff generate-shell-completion zsh)"
command_found gcloud && . "$GCLOUD_HOME/completion.zsh.inc"
command_found poe && eval "$(poe _zsh_completion)"
command_found stern && eval "$(stern --completion zsh)"
command_found yq && eval "$(yq shell-completion zsh)"
command_found uv &&  eval "$(uv generate-shell-completion zsh)"

command_found yq && eval "$(task --completion zsh)"

command_found rsctl && eval "$(rsctl --show-completion zsh)"
for app in crane gcrane krane argo kn istioctl minikube skaffold helm kubectl chezmoi; do
  command_found $app && eval "$($app completion zsh)"
done

# gvm installs a chpwd hook whose helpers (_encode/_decode) are dropped by
# Claude Code's shell snapshotter, spamming "command not found" on every cd.
# It's useless in Claude's non-interactive shell, so skip it there.
[[ -z "$CLAUDECODE" && -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"

set +x

# nvm (NVM_DIR exported in ~/.shenv)
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion

# bun completions (BUN_INSTALL exported in ~/.shenv)
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X" # boot up x-cmd.
