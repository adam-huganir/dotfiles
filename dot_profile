# Common shell environment for bash and zsh

# IFNDEF etc
if [ "${DOTFILES_PROFILE_LOADED-}" = "1" ]; then
  return 0 2>/dev/null || true
fi
export DOTFILES_PROFILE_LOADED=1
export DOTFILES_HOME="$HOME/dotfiles"

# Shared helper functions (command_found, exists, add_to_path)
[ -s "$HOME/.functions" ] && . "$HOME/.functions"

export LANG="${LANG:-en_US.UTF-8}"

# Python environmental variables
export PYTHONPYCACHEPREFIX="$HOME/.__pycache__" # don't clutter up my code directories
export PYTHONUNBUFFERED=true
export PYTHONIOENCODING=utf-8

# Load profile functions
if [ -s "$DOTFILES_HOME/profile_functions.sh" ]; then
  . "$DOTFILES_HOME/profile_functions.sh"
fi

# User bin directories
[ -d "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"

# App tools
[ -d "$HOME/.lmstudio/bin" ] && PATH="$PATH:$HOME/.lmstudio/bin"
[ -d "$HOME/.local/share/JetBrains/Toolbox/scripts" ] && PATH="$PATH:$HOME/.local/share/JetBrains/Toolbox/scripts"

# Language toolchains
[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
# Skip gvm under Claude Code: its chpwd hook calls _encode/_decode helpers that
# Claude's shell snapshotter drops, spamming "command not found" on every cd.
[ -z "$CLAUDECODE" ] && [ -s "$HOME/.gvm/scripts/gvm" ] && . "$HOME/.gvm/scripts/gvm"

export PATH
